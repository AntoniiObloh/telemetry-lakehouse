# Copy to terraform.tfvars (git-ignored) and fill in your own values.
suffix             = "<suffix>"
alert_email        = "<you@example.com>"
uc_master_role_arn = "arn:aws:iam::<account-id>:role/<uc-master-role-from-databricks>"
tfstate_bucket     = "tl-tfstate-<suffix>" # same as in backend.hcl

